# ==============================================================================
# Production Environment: Variable Definitions Template
# ==============================================================================
# Copy this file to terraform.tfvars and populate with your environment values:
#   cp terraform.tfvars.example terraform.tfvars
#
# DO NOT commit terraform.tfvars into version control.
# ==============================================================================

# Target Google Cloud Project ID for the Production environment
prod_project_id = "your-prod-project-id"

# Google Cloud Region for production resources
region          = "us-central1"

# Name of the ADK agent
agent_name      = "greeting-agent"
