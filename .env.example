# ==============================================================================
# Enterprise ADK SDLC Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace with your project-specific configuration.
# NEVER commit the real .env file into version control.

# Execution stage: dev, test, or prod
ENVIRONMENT=dev

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-test-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# LLM Model Specification (Vertex AI)
LLM_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# Custom Application Variables (managed via Pydantic Settings)
GREETING_BANNER=Enterprise ADK SDLC Pipeline Live

# Dependent Cloud Resource (Google Cloud Storage Bucket)
GCS_BUCKET_NAME=your-test-project-id-data
